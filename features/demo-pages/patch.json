{
  "name": "demo-pages",
  "requires": [],
  "copy": [
    "src/router/index.ts",
    "src/router/mainRoutes.ts",
    "src/types/enums/path.enum.ts",
    "src/types/enums/index.ts",
    "src/types/index.ts",
    "src/views/HomeView.vue",
    "src/views/AboutView.vue",
    "src/components/pages/home/HomePage.vue",
    "src/components/pages/home/HomeHero.vue",
    "src/components/pages/home/HomeActions.vue",
    "src/components/pages/about/AboutPage.vue",
    "src/components/pages/about/AboutInfo.vue",
    "src/components/ui/UiButton.vue",
    "src/layouts/default.vue"
  ],
  "patches": [
    {
      "file": "src/main.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:import",
      "lines": [
        "import router from \"@/router\""
      ]
    },
    {
      "file": "src/main.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:use",
      "lines": [
        "app.use(router)"
      ]
    },
    {
      "file": "src/types/enums/index.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:enum-exports",
      "lines": [
        "export * from \"./path.enum\""
      ]
    },
    {
      "file": "src/types/index.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:type-exports",
      "lines": [
        "export * from \"./enums\""
      ]
    },
    {
      "file": "src/router/mainRoutes.ts",
      "action": "replace-entire",
      "content": "import type { RouteRecordRaw } from \"vue-router\"\nimport { ROUTE_PATH, ROUTE_NAME } from \"@/types\"\n\nexport const routes: RouteRecordRaw[] = [\n  {\n    path: ROUTE_PATH.HOME,\n    component: () => import(\"@/layouts/default.vue\"),\n    children: [\n      {\n        path: \"\",\n        name: ROUTE_NAME.HOME,\n        component: () => import(\"@/views/HomeView.vue\")\n      },\n      {\n        path: ROUTE_PATH.ABOUT,\n        name: ROUTE_NAME.ABOUT,\n        component: () => import(\"@/views/AboutView.vue\")\n      }\n    ]\n  }\n]\n"
    },
    {
      "file": "src/App.vue",
      "action": "replace-entire",
      "content": "<template>\n  <div class=\"app-shell\">\n    <RouterView />\n  </div>\n</template>\n\n<style scoped>\n.app-shell {\n  min-height: 100vh;\n  background-color: var(--color-background, #050a14);\n}\n</style>\n"
    }
  ],
  "packageJson": {
    "dependencies": [
      "vue-router"
    ]
  }
}
