    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "replace-entire",
      "content": "<script setup lang=\"ts\">\n// @webstack:hero-imports\n// @webstack:hero-store-init\n\n// @webstack:hero-version\nconst appVersion = \"1.0.0\"\n</script>\n\n<template>\n  <div>\n    <span\n      class=\"text-xs mb-6 inline-flex justify-center items-center rounded-full mx-auto bg-primary/10 px-4 py-1 border border-primary/20 font-bold text-primary tracking-widest\"\n    >\n      <!-- @webstack:hero-badge -->\n      Template v{{ appVersion }}\n    </span>\n\n    <div class=\"mx-auto mb-3 flex flex-col font-bold tracking-tighter justify-center items-center\">\n      <h1 class=\"text-white leading-[1.1] text-4xl md:text-6xl\">\n        <!-- @webstack:hero-title -->\n        Vue PWA\n      </h1>\n      <h2 class=\"text-primary leading-[1.1] text-4xl md:text-6xl\">\n        <!-- @webstack:hero-subtitle -->\n        Starter Template\n      </h2>\n    </div>\n\n    <p class=\"mt-4 mx-auto text-gray-400 max-w-[65%] leading-relaxed text-lg md:text-xl\">\n      <!-- @webstack:hero-description -->\n      A modern Vue 3 PWA template with offline support, auto-updates, and touch-optimized interface.\n    </p>\n  </div>\n</template>\n"
    },
    {
      "file": "src/components/pages/home/HomeActions.vue",
      "action": "replace-entire",
      "content": "<script setup lang=\"ts\">\nimport { ROUTE_NAME } from \"@/types\"\nimport UiButton from \"@/components/ui/UiButton.vue\"\n\nconst handleGetStarted = () => {\n  console.log(\"Get Started\")\n}\n</script>\n\n<template>\n  <div\n    class=\"flex w-full gap-2 flex-col mt-8 max-w-[180px] md:gap-4 md:flex-row md:mt-12 md:max-w-[340px]\"\n  >\n    <UiButton\n      class=\"w-full\"\n      type=\"primary\"\n      @click=\"handleGetStarted\"\n    >\n      <!-- @webstack:home-actions-get-started -->\n      Get Started\n    </UiButton>\n    <UiButton\n      class=\"w-full\"\n      type=\"outline\"\n      :to=\"{ name: ROUTE_NAME.ABOUT }\"\n    >\n      <!-- @webstack:home-actions-read-more -->\n      Read More\n    </UiButton>\n  </div>\n</template>\n"
    },
    {
      "file": "src/components/pages/about/AboutPage.vue",
      "action": "replace-entire",
      "content": "<script setup lang=\"ts\">\nimport { ROUTE_NAME } from \"@/types\"\nimport AboutInfo from \"@/components/pages/about/AboutInfo.vue\"\nimport UiButton from \"@/components/ui/UiButton.vue\"\n</script>\n\n<template>\n  <div class=\"flex flex-col items-center justify-center min-h-[80vh] px-6 text-center\">\n    <h1 class=\"text-4xl font-bold text-white tracking-tighter mb-4\">\n      <!-- @webstack:about-title -->\n      About\n    </h1>\n\n    <p class=\"max-w-lg text-gray-400 text-lg leading-relaxed mb-8\">\n      <!-- @webstack:about-description -->\n      This template is a starting point for your Vue 3 PWA project.\n    </p>\n\n    <AboutInfo />\n\n    <UiButton\n      type=\"outline\"\n      class=\"mt-8 max-w-xs\"\n      :to=\"{ name: ROUTE_NAME.HOME }\"\n    >\n      <!-- @webstack:about-return-button -->\n      ← Return\n    </UiButton>\n  </div>\n</template>\n"
