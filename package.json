{
  "name": "vue-pwa-template",
  "version": "1.0.0",
  "description": "A modern Vue 3 PWA template with offline support, auto-updates, and touch-optimized interface.",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "pwa",
    "template",
    "vite",
    "typescript",
    "pinia",
    "offline",
    "service-worker"
  ],
  "homepage": "https://github.com/davidaganov/vue-pwa-template",
  "bugs": {
    "url": "https://github.com/davidaganov/vue-pwa-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidaganov/vue-pwa-template"
  },
  "author": {
    "name": "David Aganov",
    "url": "https://github.com/davidaganov"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "translate": "polyglot-keeper sync",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-favicons": "node scripts/generate-favicons.mjs"
  },
  "dependencies": {
    "@vue/eslint-config-prettier": "^10.2.0",
    "clsx": "^2.1.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.0",
    "polyglot-keeper": "^1.3.1",
    "favicons": "^7.2.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^7.7.9",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7",
    "workbox-window": "^7.4.0"
  }
}
