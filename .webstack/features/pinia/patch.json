{
  "name": "pinia",
  "requires": [],
  "copy": ["src/stores/app.ts", "src/__tests__/stores/app.spec.ts"],
  "patches": [
    {
      "file": "src/main.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:import",
      "lines": ["import { createPinia } from \"pinia\""]
    },
    {
      "file": "src/main.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:use",
      "lines": ["const pinia = createPinia()", "app.use(pinia)"]
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "insert-before-marker",
      "marker": "// @webstack:hero-imports",
      "lines": ["import { useAppStore } from \"@/stores/app\"", "import { computed } from \"vue\""]
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "insert-before-marker",
      "marker": "// @webstack:hero-store-init",
      "lines": ["const appStore = useAppStore()"]
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "replace-marker",
      "marker": "// @webstack:hero-version\nconst appVersion = \"1.0.0\"",
      "lines": ["const appVersion = computed(() => appStore.version)"]
    },
    {
      "file": "src/__tests__/utils.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:utils-imports",
      "lines": ["import { createPinia } from \"pinia\""],
      "optional": true
    },
    {
      "file": "src/__tests__/utils.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:utils-init",
      "lines": ["const pinia = createPinia()"],
      "optional": true
    },
    {
      "file": "src/__tests__/utils.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:utils-plugins",
      "lines": ["pinia,"],
      "optional": true
    }
  ],
  "packageJson": {
    "dependencies": ["pinia"]
  }
}
