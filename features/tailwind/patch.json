      "content": "<script setup lang=\"ts\">\n// @webstack:layout-imports\n</script>\n\n<template>\n  <div class=\"flex min-h-screen overflow-hidden flex-col bg-background relative\">\n    <!-- Top Bar with Language Switcher -->\n    <div class=\"absolute top-4 pt-4 right-6 z-50\">\n      <!-- @webstack:layout-top-bar -->\n    </div>\n\n    <div class=\"flex-1 z-20 flex justify-center min-h-screen flex-col h-full p-5\">\n      <RouterView />\n    </div>\n\n    <!-- Background Glow -->\n    <div\n      class=\"absolute z-10 pointer-events-none bottom-10 -left-20 w-64 h-64 bg-violet-600/10 rounded-full blur-[100px]\"\n    />\n    <div\n      class=\"absolute z-10 pointer-events-none bottom-20 -right-20 w-80 h-80 bg-violet-600/10 rounded-full blur-[80px]\"\n    />\n  </div>\n</template>\n"
    },
    {
      "file": "src/components/ui/UiButton.vue",
      "action": "replace-entire",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\"\nimport { type RouteLocationRaw, RouterLink } from \"vue-router\"\n\nconst props = withDefaults(\n  defineProps<{\n    type?: \"primary\" | \"secondary\" | \"outline\"\n    disabled?: boolean\n    loading?: boolean\n    to?: RouteLocationRaw\n  }>(),\n  {\n    type: \"primary\",\n    disabled: false,\n    loading: false,\n    to: undefined\n  }\n)\n\nconst emit = defineEmits<{\n  (e: \"click\", event: MouseEvent): void\n}>()\n\nconst isDisabled = computed(() => props.disabled || props.loading)\n\nconst buttonClasses = computed(() => [\n  \"inline-flex items-center justify-center w-full rounded-lg px-5 py-2.5 transition-all duration-300 no-underline\",\n  {\n    \"bg-primary shadow-[0_0_20px_rgba(139,92,246,0.3)] hover:brightness-110 cursor-pointer\":\n      props.type === \"primary\",\n    \"bg-secondary border border-white/10 hover:brightness-110 cursor-pointer\":\n      props.type === \"secondary\",\n    \"border border-primary/50 bg-primary/5 hover:brightness-110 cursor-pointer\": props.type === \"outline\",\n    \"opacity-50 cursor-not-allowed pointer-events-none\": isDisabled.value\n  }\n])\n\nconst textClasses = computed(() => [\n  \"text-sm font-medium tracking-wide\",\n  {\n    \"text-white\": props.type === \"primary\" || props.type === \"secondary\",\n    \"text-primary\": props.type === \"outline\"\n  }\n])\n\nconst onClick = (event: MouseEvent) => {\n  if (isDisabled.value) {\n    event.preventDefault()\n    return\n  }\n  emit(\"click\", event)\n}\n</script>\n\n<template>\n  <RouterLink\n    v-if=\"to\"\n    :to=\"to\"\n    :class=\"buttonClasses\"\n    :aria-disabled=\"isDisabled || undefined\"\n    :tabindex=\"isDisabled ? -1 : undefined\"\n    @click=\"onClick\"\n  >\n    <span\n      v-if=\"!loading\"\n      :class=\"textClasses\"\n    >\n      <slot />\n    </span>\n    <span\n      v-else\n      class=\"text-sm font-medium text-white opacity-70\"\n    >\n      Loading...\n    </span>\n  </RouterLink>\n\n  <button\n    v-else\n    type=\"button\"\n    :class=\"buttonClasses\"\n    :disabled=\"isDisabled\"\n    @click=\"onClick\"\n  >\n    <span\n      v-if=\"!loading\"\n      :class=\"textClasses\"\n    >\n      <slot />\n    </span>\n    <span\n      v-else\n      class=\"text-sm font-medium text-white opacity-70\"\n    >\n      Loading...\n    </span>\n  </button>\n</template>\n"
    },
